# Copiar a .env y cambiar los valores. .env nunca se sube al repositorio.
# Las lee buildshield-core (perfil local).
CORE_DB_USER=buildshield_core
CORE_DB_PASSWORD=cambiar-esto

# Separar dueño/migrador y ejecución al aplicar docs/database/runtime-role.sql.
# En local son opcionales; si se omiten, Flyway usa las credenciales locales anteriores.
# CORE_DB_MIGRATION_USER=buildshield_migrator
# CORE_DB_MIGRATION_PASSWORD=configurar-fuera-del-repositorio
# En producción DB_MIGRATION_USER y DB_MIGRATION_PASSWORD son obligatorias y diferentes de DB_USER.
