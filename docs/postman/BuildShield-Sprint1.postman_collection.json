{
  "info": {
    "name": "BuildShield Core - Sprint 1",
    "description": "Flujo principal del Sprint 1 (US01-US05, US14-US18, US20, US21): registro de la organización, usuarios, obra, almacén, material, asignaciones, carga de stock, pedido, aprobación y consulta. Ejecutar las carpetas en orden; cada petición guarda en variables de la colección los tokens e ids que usan las siguientes. El RUC y los correos se generan en cada corrida para poder repetirla.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": "Segura123"
    },
    {
      "key": "siteManagerPassword",
      "value": "Obra12345"
    },
    {
      "key": "warehouseManagerPassword",
      "value": "Almacen123"
    }
  ],
  "item": [
    {
      "name": "1. Registro de la organización (US01)",
      "item": [
        {
          "name": "Registrar organización y administrador",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Datos nuevos en cada corrida: RUC, correos y SKU no se repiten.",
                  "const runId = Date.now().toString().slice(-9);",
                  "pm.collectionVariables.set(\"runId\", runId);",
                  "pm.collectionVariables.set(\"ruc\", \"20\" + runId);",
                  "pm.collectionVariables.set(\"adminEmail\", \"admin.\" + runId + \"@andina.pe\");",
                  "pm.collectionVariables.set(\"siteManagerEmail\", \"obra.\" + runId + \"@andina.pe\");",
                  "pm.collectionVariables.set(\"warehouseManagerEmail\", \"almacen.\" + runId + \"@andina.pe\");",
                  "pm.collectionVariables.set(\"sku\", \"CEM-\" + runId);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"organizationId\", body.organizationId);",
                  "pm.collectionVariables.set(\"adminId\", body.administratorId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/sign-up",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "sign-up"
              ]
            },
            "description": "Crea la organización (RUC de 11 dígitos) y su administrador en una transacción.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ruc\": \"{{ruc}}\",\n  \"legalName\": \"Constructora Andina {{runId}} SAC\",\n  \"adminFullName\": \"Ana Torres\",\n  \"adminEmail\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Registrar el mismo RUC otra vez (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 409\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"Código RUC_ALREADY_REGISTERED\", function () {",
                  "    pm.expect(body.code).to.eql(\"RUC_ALREADY_REGISTERED\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/sign-up",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "sign-up"
              ]
            },
            "description": "El RUC es único.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ruc\": \"{{ruc}}\",\n  \"legalName\": \"Otra empresa SAC\",\n  \"adminFullName\": \"Otra Persona\",\n  \"adminEmail\": \"otra.{{runId}}@andina.pe\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
