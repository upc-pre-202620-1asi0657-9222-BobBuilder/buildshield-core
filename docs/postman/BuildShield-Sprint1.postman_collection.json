        },
        {
          "name": "Registrar entrada de material",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"Saldo de 500\", function () {",
                  "    pm.expect(Number(body.availableQty)).to.eql(500);",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Conservar esta clave para reintentos; borrar la variable de colección solo para una intención nueva.",
                  "if (!pm.collectionVariables.get(\"operation_key_registrar_entrada_de_material\")) {",
                  "  pm.collectionVariables.set(\"operation_key_registrar_entrada_de_material\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{operation_key_registrar_entrada_de_material}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stock/entries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "stock",
                "entries"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{warehouseManagerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"materialId\": \"{{materialId}}\",\n  \"quantity\": 500,\n  \"note\": \"Guía 001-2345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "\nIdempotency-Key obligatoria. Repetir con la misma clave y datos recupera el resultado; borrar la variable operation_key_registrar_entrada_de_material para iniciar otra operación."
          }
        },
        {
          "name": "Consultar stock del almacén",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"Un material con 500 disponibles\", function () {",
                  "    pm.expect(body.length).to.eql(1);",
                  "    pm.expect(Number(body[0].availableQty)).to.eql(500);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stock?warehouseId={{warehouseId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "stock"
              ],
              "query": [
                {
                  "key": "warehouseId",
                  "value": "{{warehouseId}}"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{warehouseManagerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
